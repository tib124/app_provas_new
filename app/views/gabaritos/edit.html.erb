<div class="mx-auto max-w-3xl space-y-6">
  <div class="flex items-center gap-1.5 text-sm text-slate-400">
    <%= link_to prova_path(@prova), class: "font-medium hover:text-slate-600 transition-colors" do %>
      <%= @prova.titulo %>
    <% end %>
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
    <%= link_to prova_gabarito_path(@prova), class: "font-medium hover:text-slate-600 transition-colors" do %>
      Gabarito
    <% end %>
  </div>

  <div>
    <h1 class="text-2xl font-bold tracking-tight text-slate-900">Editar gabarito</h1>
    <p class="mt-1 text-slate-600"><%= @prova.titulo %></p>
  </div>

  <%= render "form", prova: @prova, questao: @questao, gabarito: @gabarito %>
</div>
