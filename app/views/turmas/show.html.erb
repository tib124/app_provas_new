<div class="space-y-8">

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- HEADER                                                      -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <header>
    <%= link_to turmas_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-400 hover:text-slate-600 transition-colors group mb-5" do %>
      <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      Turmas
    <% end %>

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight"><%= @turma.nome %></h1>
        <p class="text-sm text-slate-500 mt-0.5">Criada em <%= @turma.created_at.strftime("%d de %B de %Y") %></p>
      </div>
      <div class="flex items-center gap-2.5 shrink-0">
        <%= link_to edit_turma_path(@turma), class: "inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 transition-colors duration-150" do %>
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
          Editar
        <% end %>
        <%= button_to turma_path(@turma), method: :delete, data: { turbo_confirm: "Tem certeza que deseja excluir esta turma? Os alunos não serão excluídos, apenas desvinculados." }, class: "inline-flex items-center gap-2 rounded-xl border border-rose-200 bg-white px-4 py-2.5 text-sm font-semibold text-rose-600 shadow-sm hover:bg-rose-50 hover:border-rose-300 transition-colors duration-150" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          Excluir
        <% end %>
      </div>
    </div>
  </header>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- STATS                                                       -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
    <div class="relative rounded-2xl bg-white border border-slate-200/80 p-4 shadow-sm overflow-hidden">
      <div class="absolute inset-y-0 left-0 w-1 rounded-l-2xl bg-teal-500"></div>
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-0.5">Alunos</p>
      <p class="text-2xl font-extrabold text-slate-900"><%= @alunos.size %></p>
    </div>
    <div class="relative rounded-2xl bg-white border border-slate-200/80 p-4 shadow-sm overflow-hidden">
      <div class="absolute inset-y-0 left-0 w-1 rounded-l-2xl bg-indigo-500"></div>
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-0.5">Com provas</p>
      <p class="text-2xl font-extrabold text-slate-900"><%= @alunos.count { |a| a.provas.any? } %></p>
    </div>
    <div class="relative rounded-2xl bg-white border border-slate-200/80 p-4 shadow-sm overflow-hidden">
      <div class="absolute inset-y-0 left-0 w-1 rounded-l-2xl bg-emerald-500"></div>
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-0.5">Total de provas</p>
      <p class="text-2xl font-extrabold text-slate-900"><%= @alunos.sum { |a| a.provas.size } %></p>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- ALUNOS LIST                                                 -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <% if @alunos.any? %>
    <div class="rounded-2xl bg-white border border-slate-200/80 shadow-sm overflow-hidden">
      <!-- Table header -->
      <div class="hidden sm:grid sm:grid-cols-12 gap-4 px-6 py-3 border-b border-slate-100 bg-slate-50/50">
        <div class="col-span-5 text-xs font-semibold text-slate-400 uppercase tracking-wider">Aluno</div>
        <div class="col-span-3 text-xs font-semibold text-slate-400 uppercase tracking-wider">E-mail</div>
        <div class="col-span-2 text-xs font-semibold text-slate-400 uppercase tracking-wider">Provas</div>
        <div class="col-span-2 text-xs font-semibold text-slate-400 uppercase tracking-wider text-right">Ações</div>
      </div>

      <div class="divide-y divide-slate-100/80">
        <% avatar_colors = [
          'from-indigo-400 to-violet-400',
          'from-emerald-400 to-teal-400',
          'from-amber-400 to-orange-400',
          'from-rose-400 to-pink-400',
          'from-sky-400 to-cyan-400',
          'from-fuchsia-400 to-purple-400'
        ] %>
        <% @alunos.each_with_index do |aluno, index| %>
          <% provas_count = aluno.provas.size %>
          <% color = avatar_colors[index % avatar_colors.length] %>

          <div class="group px-6 py-4 hover:bg-slate-50/60 transition-colors duration-150">
            <div class="sm:grid sm:grid-cols-12 sm:gap-4 sm:items-center flex flex-col gap-3">
              <!-- Name + RA -->
              <div class="col-span-5 flex items-center gap-3 min-w-0">
                <div class="shrink-0 w-9 h-9 rounded-lg bg-gradient-to-br <%= color %> flex items-center justify-center text-white text-sm font-bold group-hover:scale-105 transition-transform duration-200">
                  <%= aluno.nome[0].upcase %>
                </div>
                <div class="min-w-0">
                  <p class="text-sm font-semibold text-slate-900 truncate"><%= aluno.nome %></p>
                  <p class="text-xs text-slate-400 font-medium"><%= aluno.ra %></p>
                </div>
              </div>

              <!-- Email -->
              <div class="col-span-3 min-w-0">
                <p class="text-sm text-slate-600 truncate"><%= aluno.email %></p>
              </div>

              <!-- Provas count -->
              <div class="col-span-2">
                <% if provas_count > 0 %>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-indigo-50 text-xs font-semibold text-indigo-600">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
                    <%= provas_count %> prova<%= provas_count != 1 ? 's' : '' %>
                  </span>
                <% else %>
                  <span class="text-xs text-slate-300 font-medium">—</span>
                <% end %>
              </div>

              <!-- Actions -->
              <div class="col-span-2 flex items-center justify-end gap-1.5">
                <%= link_to edit_aluno_path(aluno), class: "inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50 hover:border-slate-300 transition-colors duration-150" do %>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                  Editar
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="rounded-2xl border-2 border-dashed border-slate-200 bg-white p-12 text-center">
      <div class="mx-auto w-14 h-14 rounded-xl bg-slate-100 flex items-center justify-center mb-4">
        <svg class="w-7 h-7 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/></svg>
      </div>
      <h3 class="text-sm font-bold text-slate-900 mb-1">Nenhum aluno nesta turma</h3>
      <p class="text-xs text-slate-500 max-w-xs mx-auto mb-5">Vincule alunos a esta turma editando o cadastro de cada aluno.</p>
      <div class="flex items-center justify-center">
        <%= link_to alunos_path, class: "inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 transition-colors duration-150" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-2a6 6 0 0112 0v2zm0 0h6v-2a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          Ver alunos
        <% end %>
      </div>
    </div>
  <% end %>
</div>
