<%= form_with model: aluno, class: "space-y-6", data: { controller: "aluno-form" } do |f| %>
  <% if aluno.errors.any? %>
    <div class="rounded-2xl border border-rose-200 bg-rose-50/80 px-5 py-4 text-sm text-rose-900 shadow-sm animate-[shake_0.4s_ease-in-out]">
      <div class="flex items-start gap-3">
        <div class="shrink-0 mt-0.5">
          <svg class="w-5 h-5 text-rose-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
        </div>
        <div>
          <p class="font-semibold">Corrija os erros abaixo para continuar:</p>
          <ul class="mt-2 space-y-1">
            <% aluno.errors.full_messages.each do |msg| %>
              <li class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-rose-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd"/></svg>
                <%= msg %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <%# ── Seção 1: Identificação ── %>
  <section class="rounded-2xl border border-slate-200/80 bg-white shadow-sm overflow-hidden transition-shadow hover:shadow-md">
    <div class="flex items-center gap-3 px-6 py-4 border-b border-slate-100 bg-slate-50/50">
      <div class="w-7 h-7 rounded-lg bg-indigo-500 text-white text-xs font-bold flex items-center justify-center shrink-0">1</div>
      <div>
        <h2 class="text-sm font-bold text-slate-900">Identificação do aluno</h2>
        <p class="text-xs text-slate-500">RA e nome completo</p>
      </div>
    </div>
    <div class="p-6 space-y-5">
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
        <div>
          <%= f.label :ra, class: "flex items-center gap-1.5 text-sm font-medium text-slate-700" do %>
            <svg class="w-4 h-4 text-indigo-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5zm6-10.125a1.875 1.875 0 11-3.75 0 1.875 1.875 0 013.75 0zm1.294 6.336a6.721 6.721 0 01-3.17.789 6.721 6.721 0 01-3.168-.789 3.376 3.376 0 016.338 0z"/></svg>
            RA (Registro Acadêmico)
          <% end %>
          <div class="relative mt-1.5">
            <%= f.text_field :ra,
                             autofocus: !aluno.persisted?,
                             placeholder: "Ex: N874321",
                             disabled: aluno.persisted?,
                             data: { aluno_form_target: "raInput", action: "input->aluno-form#validateRa" },
                             class: "w-full rounded-xl border border-slate-300/80 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 disabled:bg-slate-50 disabled:text-slate-500 disabled:cursor-not-allowed font-mono tracking-wide uppercase" %>
            <% if aluno.persisted? %>
              <div class="absolute inset-y-0 right-0 flex items-center pr-3">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg>
              </div>
            <% end %>
          </div>
          <% if aluno.persisted? %>
            <p class="mt-1.5 flex items-center gap-1 text-xs text-amber-600">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126z"/></svg>
              O RA não pode ser alterado após o cadastro
            </p>
          <% else %>
            <p class="mt-1.5 text-xs text-slate-500" data-aluno-form-target="raHint">Formato: uma letra seguida de números (ex: N874321)</p>
          <% end %>
        </div>

        <div class="sm:col-span-2">
          <%= f.label :nome, class: "flex items-center gap-1.5 text-sm font-medium text-slate-700" do %>
            <svg class="w-4 h-4 text-indigo-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
            Nome completo
          <% end %>
          <%= f.text_field :nome,
                           autofocus: aluno.persisted?,
                           placeholder: "Ex: João Silva",
                           class: "mt-1.5 w-full rounded-xl border border-slate-300/80 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100" %>
        </div>
      </div>
    </div>
  </section>

  <%# ── Seção 2: Contato ── %>
  <section class="rounded-2xl border border-slate-200/80 bg-white shadow-sm overflow-hidden transition-shadow hover:shadow-md">
    <div class="flex items-center gap-3 px-6 py-4 border-b border-slate-100 bg-slate-50/50">
      <div class="w-7 h-7 rounded-lg bg-violet-500 text-white text-xs font-bold flex items-center justify-center shrink-0">2</div>
      <div>
        <h2 class="text-sm font-bold text-slate-900">Contato</h2>
        <p class="text-xs text-slate-500">E-mail do aluno</p>
      </div>
    </div>
    <div class="p-6">
      <%= f.label :email, class: "flex items-center gap-1.5 text-sm font-medium text-slate-700" do %>
        <svg class="w-4 h-4 text-violet-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
        E-mail
      <% end %>
      <%= f.email_field :email,
                        placeholder: "aluno@email.com",
                        class: "mt-1.5 w-full rounded-xl border border-slate-300/80 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100" %>
      <p class="mt-1.5 text-xs text-slate-500">Será usado para identificar o aluno nas provas</p>
    </div>
  </section>

  <%# ── Seção 3: Turma ── %>
  <section class="rounded-2xl border border-slate-200/80 bg-white shadow-sm overflow-hidden transition-shadow hover:shadow-md">
    <div class="flex items-center gap-3 px-6 py-4 border-b border-slate-100 bg-slate-50/50">
      <div class="w-7 h-7 rounded-lg bg-emerald-500 text-white text-xs font-bold flex items-center justify-center shrink-0">3</div>
      <div>
        <h2 class="text-sm font-bold text-slate-900">Turma</h2>
        <p class="text-xs text-slate-500">Vincule a uma turma (opcional)</p>
      </div>
    </div>
    <div class="p-6">
      <% turmas = current_user.turmas.order(nome: :asc) %>
      <% if turmas.any? %>
        <%= f.label :turma_id, class: "flex items-center gap-1.5 text-sm font-medium text-slate-700" do %>
          <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"/></svg>
          Selecionar turma
        <% end %>
        <%= f.collection_select :turma_id,
                                turmas, :id, :nome,
                                { include_blank: "— Sem turma —", prompt: nil },
                                class: "mt-1.5 w-full rounded-xl border border-slate-300/80 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100" %>
        <p class="mt-1.5 text-xs text-slate-500">
          Opcional — organiza alunos por turma.
          <%= link_to new_turma_path, class: "inline-flex items-center gap-0.5 text-indigo-600 hover:text-indigo-700 font-medium" do %>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            Criar nova turma
          <% end %>
        </p>
      <% else %>
        <div class="rounded-xl border-2 border-dashed border-slate-200 bg-slate-50/50 p-5 text-center">
          <div class="mx-auto w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"/></svg>
          </div>
          <p class="text-sm font-medium text-slate-700 mb-1">Nenhuma turma criada ainda</p>
          <p class="text-xs text-slate-500 mb-3">Crie uma turma para organizar seus alunos</p>
          <%= link_to new_turma_path, class: "inline-flex items-center gap-1.5 rounded-lg bg-emerald-50 border border-emerald-200 px-3 py-1.5 text-xs font-semibold text-emerald-700 hover:bg-emerald-100 transition-colors" do %>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            Criar primeira turma
          <% end %>
        </div>
      <% end %>
    </div>
  </section>

  <%# ── Ações ── %>
  <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-3 pt-2">
    <%= link_to alunos_path, class: "inline-flex items-center justify-center gap-1.5 rounded-xl border border-slate-300/80 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-300 focus:ring-offset-2" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3"/></svg>
      Cancelar
    <% end %>
    <%= f.submit (aluno.persisted? ? "Salvar alterações" : "Cadastrar aluno"),
         class: "inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-indigo-600 to-sky-600 px-6 py-3 text-sm font-semibold text-white shadow-md shadow-indigo-200/60 transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-indigo-300/40 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:ring-offset-2 active:translate-y-0 cursor-pointer" %>
  </div>
<% end %>
</div>
