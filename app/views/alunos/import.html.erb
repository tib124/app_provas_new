<div class="space-y-6">
  <div>
    <%= link_to alunos_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-400 hover:text-slate-600 transition-colors group" do %>
      <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      Alunos
    <% end %>
  </div>

  <div>
    <p class="text-sm font-semibold text-slate-600">Importar Alunos</p>
    <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-900">Adicionar vários alunos ao mesmo tempo</h1>
    <p class="mt-1 text-slate-600">Faça upload de um arquivo CSV para inserir diversos alunos de uma vez.</p>
  </div>

  <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm ring-1 ring-black/5">
    <div class="mb-6">
      <h2 class="text-lg font-semibold text-slate-900">Como preparar o arquivo</h2>
      <p class="mt-2 text-sm text-slate-600">Basta usar um editor de planilhas ou texto e criar um arquivo com estas colunas na primeira linha:</p>
      
      <ul class="mt-3 list-disc list-inside text-sm text-slate-600 space-y-1">
        <li><code class="bg-slate-100 px-1 rounded">ra</code> – número de matrícula do aluno (obrigatório)</li>
        <li><code class="bg-slate-100 px-1 rounded">nome</code> – nome completo do aluno (obrigatório)</li>
        <li><code class="bg-slate-100 px-1 rounded">email</code> – endereço de e‑mail (obrigatório)</li>
        <li><code class="bg-slate-100 px-1 rounded">turma</code> – nome da turma (opcional; será criada automaticamente)</li>
      </ul>

      <div class="mt-4 p-4 rounded-lg bg-blue-50 border border-blue-200">
        <p class="text-sm text-blue-900"><strong>💡 Dica rápida:</strong> Abra Excel, Google Sheets ou um editor de texto, copie os dados e salve como <code>.csv</code>. Em seguida envie o arquivo aqui.</p>
      </div>

    </div>

    <div class="border-t border-slate-200 pt-6">
      <%= form_with url: process_import_alunos_path, method: :post, local: true, class: "space-y-4" do |f| %>
        <div>
          <%= f.label :csv_file, "Selecione o arquivo CSV", class: "block text-sm font-semibold text-slate-900" %>
          <%= f.file_field :csv_file, accept: '.csv', class: "mt-2 block w-full rounded-xl border border-slate-300/80 bg-white/80 px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200", required: true %>
          <p class="mt-1 text-xs text-slate-600">Apenas arquivos CSV são aceitos</p>
        </div>

        <div>
          <%= f.label :turma_id, "Turma padrão (opcional)", class: "block text-sm font-semibold text-slate-900" %>
          <%= f.collection_select :turma_id,
                                  current_user.turmas.order(nome: :asc), :id, :nome,
                                  { include_blank: "— Sem turma padrão —" },
                                  class: "mt-2 w-full rounded-xl border border-slate-300/80 bg-white/80 px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200" %>
          <p class="mt-1 text-xs text-slate-500">Aplicada a todos os alunos que não tiverem a coluna <code class="bg-slate-100 px-1 py-0.5 rounded">turma</code> no CSV. A coluna do CSV tem prioridade.</p>
        </div>

        <div class="flex gap-3 pt-2">
          <%= f.submit "Importar alunos", class: "inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-indigo-600 to-sky-600 px-5 py-3 text-sm font-semibold text-white shadow-sm shadow-indigo-200/60 transition hover:-translate-y-0.5 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:ring-offset-2" %>
          <%= link_to "Cancelar", alunos_path, class: "inline-flex items-center justify-center rounded-xl border border-slate-300/80 bg-white px-5 py-3 text-sm font-semibold text-slate-900 shadow-sm transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-300 focus:ring-offset-2" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="rounded-2xl border border-slate-200/80 bg-slate-50/60 p-6 ring-1 ring-black/5">
    <h3 class="text-sm font-semibold text-slate-900">Exemplo de CSV</h3>
    <pre class="mt-3 overflow-x-auto rounded-lg bg-white p-3 text-xs text-slate-700 border border-slate-200"><code>ra,nome,email,turma
A874321,João Silva,joao@email.com,3º Ano A
B123456,Maria Santos,maria@email.com,3º Ano A
C987654,Pedro Oliveira,pedro@email.com,2º Ano B</code></pre>
    <p class="mt-2 text-xs text-slate-500">A coluna <code class="bg-slate-100 px-1 py-0.5 rounded">turma</code> é opcional. Se omitida, será usada a turma padrão selecionada acima (se houver).</p>
  </div>
</div>
