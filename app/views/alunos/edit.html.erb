<div class="space-y-6">
  <div>
    <%= link_to alunos_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-400 hover:text-slate-600 transition-colors group" do %>
      <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      Alunos
    <% end %>
  </div>

  <div>
    <p class="text-sm font-semibold text-slate-600">Aluno</p>
    <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-900">Editar aluno</h1>
    <p class="mt-1 text-slate-600">Atualize nome e e-mail.</p>
  </div>

  <%= render "form", aluno: @aluno %>
</div>
