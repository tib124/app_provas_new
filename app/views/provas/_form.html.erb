<%= form_with model: prova, class: "space-y-8" do |f| %>
  <% if prova.errors.any? %>
    <div class="rounded-2xl border border-rose-200 bg-rose-50 px-5 py-4 text-sm text-rose-900">
      <div class="flex items-center gap-2 font-semibold">
        <svg class="w-5 h-5 text-rose-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
        Verifique os campos:
      </div>
      <ul class="mt-2 list-disc pl-5 space-y-0.5">
        <% prova.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="rounded-2xl border border-slate-200/80 bg-white shadow-sm overflow-hidden">
    <div class="flex items-center gap-3 px-6 py-4 border-b border-slate-100 bg-slate-50/50">
      <div class="w-7 h-7 rounded-lg bg-indigo-500 text-white text-xs font-bold flex items-center justify-center shrink-0">1</div>
      <div>
        <h2 class="text-sm font-bold text-slate-900">Informações da prova</h2>
        <p class="text-xs text-slate-500">Título e data de aplicação</p>
      </div>
    </div>
    <div class="p-6">
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <%= f.label :titulo, class: "block text-sm font-medium text-slate-700" %>
          <%= f.text_field :titulo, autofocus: true, placeholder: "Ex: Prova de Matemática", class: "mt-1.5 w-full rounded-xl border border-slate-300/80 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100" %>
        </div>
        <div>
          <%= f.label :data_criacao, "Data", class: "block text-sm font-medium text-slate-700" %>
          <%= f.date_field :data_criacao, class: "mt-1.5 w-full rounded-xl border border-slate-300/80 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100" %>
        </div>
      </div>
    </div>
  </section>

  <section class="rounded-2xl border border-slate-200/80 bg-white shadow-sm overflow-hidden">
    <div class="flex items-center gap-3 px-6 py-4 border-b border-slate-100 bg-slate-50/50">
      <div class="w-7 h-7 rounded-lg bg-violet-500 text-white text-xs font-bold flex items-center justify-center shrink-0">2</div>
      <div>
        <h2 class="text-sm font-bold text-slate-900">Aluno</h2>
        <p class="text-xs text-slate-500">Vincule a prova a um aluno cadastrado</p>
      </div>
    </div>
    <div class="p-6">
      <%= f.collection_select :aluno_ra,
                              (@alunos || []),
                              :ra,
                              :display_name,
                              { include_blank: "Selecione um aluno…" },
                              class: "w-full rounded-xl border border-slate-300/80 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100" %>
      <div class="mt-3 flex items-center gap-2 text-xs text-slate-500">
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
        Aluno não cadastrado? <%= link_to "Cadastre aqui", new_aluno_path, class: "font-semibold text-indigo-600 hover:text-indigo-700 underline underline-offset-2" %>
      </div>
    </div>
  </section>

  <section class="rounded-2xl border border-slate-200/80 bg-white shadow-sm overflow-hidden" data-controller="nested-questions">
    <div class="flex items-center justify-between gap-4 px-6 py-4 border-b border-slate-100 bg-slate-50/50">
      <div class="flex items-center gap-3">
        <div class="w-7 h-7 rounded-lg bg-emerald-500 text-white text-xs font-bold flex items-center justify-center shrink-0">3</div>
        <div>
          <h2 class="text-sm font-bold text-slate-900">Questões</h2>
          <p class="text-xs text-slate-500">Adicione as questões com enunciado e tipo</p>
        </div>
      </div>
      <button type="button" data-action="nested-questions#add" class="inline-flex items-center gap-1.5 rounded-xl bg-emerald-50 border border-emerald-200 px-3 py-1.5 text-xs font-semibold text-emerald-700 transition hover:bg-emerald-100 focus:outline-none focus:ring-2 focus:ring-emerald-300">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        Adicionar
      </button>
    </div>

    <div class="p-6 space-y-4" data-nested-questions-target="container">
      <%= f.fields_for :questoes do |qf| %>
        <div class="rounded-xl border border-slate-200 bg-slate-50/60 overflow-hidden" data-nested-questions-question data-controller="questao-fields">
          <%= qf.hidden_field :_destroy, value: 0, data: { nested_questions_target: "destroy" } %>

          <div class="flex items-center justify-between gap-3 px-4 py-3 border-b border-slate-200/60 bg-white/60">
            <div class="flex items-center gap-3 flex-1">
              <div class="flex items-center gap-2 shrink-0">
                <span class="text-xs font-bold text-slate-400 uppercase">Tipo</span>
                <%= qf.select :tipo,
                  [["Múltipla escolha", "multipla_escolha"], ["Dissertativa", "dissertativa"]],
                  {},
                  class: "rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-700 outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100",
                  data: { questao_fields_target: "tipo", action: "change->questao-fields#toggle" } %>
              </div>
              <div class="flex items-center gap-1.5 shrink-0">
                <span class="text-xs font-bold text-slate-400 uppercase">Peso</span>
                <%= qf.number_field :peso, step: 0.1, min: 1, max: 10, lang: "pt-BR", class: "w-16 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-700 text-center outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100" %>
              </div>
            </div>
            <button type="button" data-action="nested-questions#remove" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition" title="Remover questão">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </div>

          <div class="p-4 space-y-4">
            <div>
              <%= qf.label :enunciado, "Enunciado", class: "block text-xs font-semibold text-slate-600 uppercase tracking-wide" %>
              <%= qf.text_area :enunciado, rows: 3, placeholder: "Digite o enunciado da questão…", class: "mt-1.5 w-full rounded-xl border border-slate-300/80 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 resize-none" %>
            </div>

            <div data-questao-fields-target="respostasWrapper">
              <%= qf.label :respostas, "Alternativas", class: "block text-xs font-semibold text-slate-600 uppercase tracking-wide" %>
              <%= qf.text_area :respostas,
                               rows: 3,
                               placeholder: "A-) Resposta A\nB-) Resposta B\nC-) Resposta C",
                               class: "mt-1.5 w-full rounded-xl border border-slate-300/80 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 resize-none font-mono",
                               data: { questao_fields_target: "respostas", action: "input->questao-fields#syncSelectOptions" } %>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div data-questao-fields-target="respostaSelectWrapper">
                <%= qf.label :resposta_colocada, "Resposta do aluno", class: "block text-xs font-semibold text-slate-600 uppercase tracking-wide" %>
                <%= qf.select :resposta_colocada,
                              qf.object.respond_to?(:alternativa_labels) ? qf.object.alternativa_labels : [],
                              { include_blank: "Selecione…" },
                              class: "mt-1.5 w-full rounded-xl border border-slate-300/80 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100",
                              data: { questao_fields_target: "respostaSelect" } %>
              </div>

              <div data-questao-fields-target="respostaTextWrapper">
                <%= qf.label :resposta_colocada, "Resposta do aluno", class: "block text-xs font-semibold text-slate-600 uppercase tracking-wide" %>
                <%= qf.text_area :resposta_colocada,
                                 rows: 2,
                                 placeholder: "Resposta do aluno…",
                                 class: "mt-1.5 w-full rounded-xl border border-slate-300/80 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 resize-none",
                                 data: { questao_fields_target: "respostaText" } %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <template data-nested-questions-target="template">
      <%= f.fields_for :questoes, Questao.new, child_index: "NEW_RECORD" do |qf| %>
        <div class="rounded-xl border border-slate-200 bg-slate-50/60 overflow-hidden" data-nested-questions-question data-controller="questao-fields">
          <%= qf.hidden_field :_destroy, value: 0, data: { nested_questions_target: "destroy" } %>

          <div class="flex items-center justify-between gap-3 px-4 py-3 border-b border-slate-200/60 bg-white/60">
            <div class="flex items-center gap-3 flex-1">
              <div class="flex items-center gap-2 shrink-0">
                <span class="text-xs font-bold text-slate-400 uppercase">Tipo</span>
                <%= qf.select :tipo,
                  [["Múltipla escolha", "multipla_escolha"], ["Dissertativa", "dissertativa"]],
                  {},
                  class: "rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-700 outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100",
                  data: { questao_fields_target: "tipo", action: "change->questao-fields#toggle" } %>
              </div>
              <div class="flex items-center gap-1.5 shrink-0">
                <span class="text-xs font-bold text-slate-400 uppercase">Peso</span>
                <%= qf.number_field :peso, value: 1.0, step: 0.1, min: 1, max: 10, lang: "pt-BR", class: "w-16 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-700 text-center outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100" %>
              </div>
            </div>
            <button type="button" data-action="nested-questions#remove" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition" title="Remover questão">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </div>

          <div class="p-4 space-y-4">
            <div>
              <%= qf.label :enunciado, "Enunciado", class: "block text-xs font-semibold text-slate-600 uppercase tracking-wide" %>
              <%= qf.text_area :enunciado, rows: 3, placeholder: "Digite o enunciado da questão…", class: "mt-1.5 w-full rounded-xl border border-slate-300/80 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 resize-none" %>
            </div>

            <div data-questao-fields-target="respostasWrapper">
              <%= qf.label :respostas, "Alternativas", class: "block text-xs font-semibold text-slate-600 uppercase tracking-wide" %>
              <%= qf.text_area :respostas,
                               rows: 3,
                               placeholder: "A-) Resposta A\nB-) Resposta B\nC-) Resposta C",
                               class: "mt-1.5 w-full rounded-xl border border-slate-300/80 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 resize-none font-mono",
                               data: { questao_fields_target: "respostas", action: "input->questao-fields#syncSelectOptions" } %>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div data-questao-fields-target="respostaSelectWrapper">
                <%= qf.label :resposta_colocada, "Resposta do aluno", class: "block text-xs font-semibold text-slate-600 uppercase tracking-wide" %>
                <%= qf.select :resposta_colocada,
                              [],
                              { include_blank: "Selecione…" },
                              class: "mt-1.5 w-full rounded-xl border border-slate-300/80 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100",
                              data: { questao_fields_target: "respostaSelect" } %>
              </div>

              <div data-questao-fields-target="respostaTextWrapper">
                <%= qf.label :resposta_colocada, "Resposta do aluno", class: "block text-xs font-semibold text-slate-600 uppercase tracking-wide" %>
                <%= qf.text_area :resposta_colocada,
                                 rows: 2,
                                 placeholder: "Resposta do aluno…",
                                 class: "mt-1.5 w-full rounded-xl border border-slate-300/80 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 resize-none",
                                 data: { questao_fields_target: "respostaText" } %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </template>
  </section>

  <div class="flex items-center justify-between gap-4 pt-2">
    <%= link_to (prova.persisted? ? prova_path(prova) : provas_path), class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-slate-700 transition-colors" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      Cancelar
    <% end %>
    <%= f.submit (prova.persisted? ? "Salvar alterações" : "Criar prova"), class: "inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-indigo-600 to-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-sm shadow-indigo-200/60 transition hover:-translate-y-0.5 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:ring-offset-2 cursor-pointer" %>
  </div>
<% end %>
