<div class="relative min-h-[60vh]">
  <div class="mb-8">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-5">
      <div>
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Minhas provas</h1>
        <p class="mt-1.5 text-slate-500 text-sm">Gerencie suas provas e acompanhe o desempenho dos alunos</p>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <%= link_to import_provas_path, class: "inline-flex items-center gap-2 rounded-xl border border-slate-300/80 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 hover:border-slate-400/60 transition-all duration-200" do %>
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
          Importar CSV
        <% end %>
        <%= link_to new_prova_path, class: "inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 px-5 py-2.5 text-sm font-bold text-white shadow-lg shadow-indigo-500/25 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-200" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Nova prova
        <% end %>
      </div>
    </div>
  </div>

  <% if @provas.any? %>
    <div class="flex flex-col sm:flex-row sm:items-center gap-2 mb-6 px-1">
      <% if params[:aluno_ra].present? %>
        <% filtered_aluno = current_user.alunos.find_by(ra: params[:aluno_ra]) %>
        <% if filtered_aluno %>
          <p class="text-sm text-slate-600">
            Mostrando provas de <strong><%= filtered_aluno.nome %></strong> (<%= filtered_aluno.ra %>)
            — <%= link_to "mostrar todas", provas_path, class: "text-indigo-600 hover:underline" %>
          </p>
        <% end %>
      <% end %>

      <p class="text-sm text-slate-500">
        <span class="font-bold text-slate-800"><%= @provas.size %></span> prova<%= @provas.size != 1 ? 's' : '' %> encontrada<%= @provas.size != 1 ? 's' : '' %>
      </p>
    </div>

    <div class="space-y-4">
      <% @provas.each do |prova| %>
        <% score = prova.calcular_score %>
        <% max_score = prova.calcular_score_maximo %>
        <% percentage = prova.calcular_percentual %>
        <% questoes_count = prova.questoes.size %>

        <div class="group rounded-2xl bg-white border border-slate-200/80 shadow-sm hover:shadow-lg hover:border-slate-300/80 transition-all duration-300 overflow-hidden">
          <div class="flex flex-col lg:flex-row">
            <div class="flex-1 p-6">
              <div class="flex items-start gap-4">
                <div class="shrink-0 hidden sm:flex w-12 h-12 rounded-xl bg-gradient-to-br from-indigo-500 to-violet-500 items-center justify-center text-white shadow-md shadow-indigo-200/50 group-hover:scale-105 transition-transform duration-300">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
                </div>

                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-3 mb-1.5">
                    <%= link_to prova.titulo, prova_path(prova), class: "text-base font-bold text-slate-900 hover:text-indigo-700 transition-colors truncate" %>
                  </div>

                  <div class="flex flex-wrap items-center gap-2 text-xs">
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 font-medium">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                      <%= l(prova.data_criacao) %>
                    </span>

                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700 font-medium">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                      <%= questoes_count %> quest<%= questoes_count != 1 ? 'ões' : 'ão' %>
                    </span>

                    <% if prova.aluno.present? %>
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-violet-50 text-violet-700 font-medium">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                        <%= prova.aluno.nome %>
                        <span class="text-violet-400 ml-0.5"><%= prova.aluno.ra %></span>
                      </span>
                    <% end %>

                    <% if max_score > 0 %>
                      <% score_color = percentage >= 70 ? 'bg-emerald-50 text-emerald-700' : percentage >= 50 ? 'bg-amber-50 text-amber-700' : 'bg-rose-50 text-rose-700' %>
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg <%= score_color %> font-semibold">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
                        <%= score.round(2) %>/<%= max_score.round(2) %> · <%= percentage %>%
                      </span>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>

            <div class="flex items-center gap-4 px-6 pb-5 lg:pb-0 lg:pr-6 lg:pl-0 lg:border-l lg:border-slate-100">
              <% if max_score > 0 %>
                <div class="hidden lg:flex flex-col items-center justify-center w-20">
                  <% ring_color = percentage >= 70 ? '#10b981' : percentage >= 50 ? '#f59e0b' : '#ef4444' %>
                  <svg class="w-14 h-14 -rotate-90" viewBox="0 0 36 36">
                    <circle cx="18" cy="18" r="15.5" fill="none" stroke="#e2e8f0" stroke-width="3"/>
                    <circle cx="18" cy="18" r="15.5" fill="none" stroke="<%= ring_color %>" stroke-width="3" stroke-linecap="round" stroke-dasharray="<%= (percentage * 97.4 / 100).round(1) %>, 97.4"/>
                  </svg>
                  <p class="text-xs font-bold text-slate-700 mt-1"><%= percentage %>%</p>
                </div>
              <% end %>

              <div class="flex items-center gap-2">
                <%= link_to prova_path(prova), class: "inline-flex items-center gap-1.5 rounded-xl bg-indigo-50 px-4 py-2 text-sm font-semibold text-indigo-700 hover:bg-indigo-100 transition-colors duration-150" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                  Abrir
                <% end %>
                <%= link_to edit_prova_path(prova), class: "inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 hover:border-slate-300 transition-colors duration-150" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                  Editar
                <% end %>
                <%= button_to prova_path(prova), method: :delete, data: { turbo_confirm: "Tem certeza que deseja excluir esta prova? Esta ação não pode ser desfeita." }, class: "inline-flex items-center gap-1.5 rounded-xl border border-rose-200 bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-700 hover:bg-rose-100 hover:border-rose-300 transition-colors duration-150" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                  Excluir
                <% end %>
              </div>
            </div>
          </div>

          <% if max_score > 0 %>
            <div class="h-1 bg-slate-100">
              <% bar_color = percentage >= 70 ? 'bg-emerald-500' : percentage >= 50 ? 'bg-amber-500' : 'bg-rose-500' %>
              <div class="h-full rounded-r-full <%= bar_color %> transition-all duration-500" style="width: <%= percentage %>%"></div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

  <% else %>
    <div class="rounded-3xl border-2 border-dashed border-slate-300 bg-white p-12 text-center">
      <div class="mx-auto w-20 h-20 rounded-2xl bg-gradient-to-br from-indigo-100 to-violet-100 flex items-center justify-center mb-5">
        <svg class="w-10 h-10 text-indigo-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
      </div>
      <h3 class="text-lg font-bold text-slate-900 mb-1.5">Nenhuma prova criada</h3>
      <p class="text-sm text-slate-500 max-w-sm mx-auto mb-6">Crie sua primeira prova para começar a adicionar questões e avaliar seus alunos.</p>
      <div class="flex items-center justify-center gap-3">
        <%= link_to new_prova_path, class: "inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-indigo-500/25 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-200" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Criar primeira prova
        <% end %>
        <%= link_to import_provas_path, class: "inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-all duration-200" do %>
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
          Importar via CSV
        <% end %>
      </div>
    </div>
  <% end %>
</div>
