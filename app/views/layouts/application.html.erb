<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Provas App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-50/50 min-h-screen">
    <% if respond_to?(:devise_controller?) && devise_controller? %>
      <%= render "layouts/alerts" %>
      <%= yield %>
    <% elsif user_signed_in? %>
      <%= render "layouts/navbar" %>
      <%= render "layouts/alerts" %>
      <main class="container mx-auto mt-8 px-5 pb-12">
        <%= yield %>
      </main>
    <% elsif controller_name == "pages" && action_name == "home" %>
      <%= render "layouts/alerts" %>
      <%= yield %>
    <% else %>
      <%= render "layouts/alerts" %>
      <main class="container mx-auto mt-12 px-5">
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
