<% display_name = @user&.username.presence || current_user.username.presence || current_user.email.split('@').first %>
<% greeting = case Time.current.hour
  when 5..11 then "Bom dia"
  when 12..17 then "Boa tarde"
  else "Boa noite"
end %>

<div class="max-w-7xl mx-auto space-y-8">══════════════════════════════════════════════════════════ -->
  <header class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
    <div class="flex items-center gap-4">
      <%= link_to edit_user_registration_path, class: "shrink-0 group" do %>
        <% if current_user.avatar.attached? %>
          <%= image_tag current_user.avatar, class: "w-14 h-14 rounded-2xl object-cover ring-2 ring-slate-200 shadow-sm group-hover:ring-indigo-300 transition-all duration-200" %>
        <% else %>
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-indigo-500 to-violet-500 flex items-center justify-center text-white text-xl font-bold ring-2 ring-slate-200 shadow-sm group-hover:ring-indigo-300 transition-all duration-200">
            <%= current_user.email[0].upcase %>
          </div>
        <% end %>
      <% end %>
      <div>
        <p class="text-sm text-slate-500 font-medium"><%= greeting %> 👋</p>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight"><%= display_name %></h1>
      </div>
    </div>

    <!-- Right: Actions -->
    <div class="flex items-center gap-2.5">
      <%= link_to edit_user_registration_path, class: "inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 transition-colors duration-150" do %>
        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><circle cx="12" cy="12" r="3"/></svg>
        Perfil
      <% end %>
      <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200 transition-colors duration-150" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
        Sair
      <% end %>
    </div>
  </header>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- STATISTICS – horizontal bar with colored left accent        -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <section>
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
      <%= link_to provas_path, class: "group block" do %>
        <div class="relative rounded-2xl bg-white border border-slate-200/80 p-5 shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden">
          <div class="absolute inset-y-0 left-0 w-1 rounded-l-2xl bg-indigo-500"></div>
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Provas</p>
              <p class="text-3xl font-extrabold text-slate-900"><%= @provas_count %></p>
            </div>
            <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-500 flex items-center justify-center group-hover:scale-110 transition-transform duration-200">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            </div>
          </div>
        </div>
      <% end %>

      <div class="group block">
        <div class="relative rounded-2xl bg-white border border-slate-200/80 p-5 shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden">
          <div class="absolute inset-y-0 left-0 w-1 rounded-l-2xl bg-emerald-500"></div>
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Questões</p>
              <p class="text-3xl font-extrabold text-slate-900"><%= @questoes_count %></p>
            </div>
            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-500 flex items-center justify-center group-hover:scale-110 transition-transform duration-200">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
          </div>
        </div>
      </div>

      <%= link_to alunos_path, class: "group block" do %>
        <div class="relative rounded-2xl bg-white border border-slate-200/80 p-5 shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden">
          <div class="absolute inset-y-0 left-0 w-1 rounded-l-2xl bg-violet-500"></div>
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Alunos</p>
              <p class="text-3xl font-extrabold text-slate-900"><%= @alunos_count %></p>
            </div>
            <div class="w-10 h-10 rounded-xl bg-violet-50 text-violet-500 flex items-center justify-center group-hover:scale-110 transition-transform duration-200">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-2a6 6 0 0112 0v2zm0 0h6v-2a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            </div>
          </div>
        </div>
      <% end %>

      <%= link_to turmas_path, class: "group block" do %>
        <div class="relative rounded-2xl bg-white border border-slate-200/80 p-5 shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden">
          <div class="absolute inset-y-0 left-0 w-1 rounded-l-2xl bg-teal-500"></div>
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Turmas</p>
              <p class="text-3xl font-extrabold text-slate-900"><%= @turmas_count %></p>
            </div>
            <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-500 flex items-center justify-center group-hover:scale-110 transition-transform duration-200">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
            </div>
          </div>
        </div>
      <% end %>

      <div class="group block">
        <div class="relative rounded-2xl bg-white border border-slate-200/80 p-5 shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden">
          <div class="absolute inset-y-0 left-0 w-1 rounded-l-2xl bg-amber-500"></div>
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Provas Este mês</p>
              <p class="text-3xl font-extrabold text-slate-900"><%= @provas_this_month %></p>
            </div>
            <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-500 flex items-center justify-center group-hover:scale-110 transition-transform duration-200">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- MAIN CONTENT: Provas + Sidebar                              -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- LEFT: Recent Provas (2/3) -->
    <section class="lg:col-span-2">
      <div class="rounded-2xl bg-white border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
          <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Provas recentes</h2>
          <%= link_to provas_path, class: "text-xs font-semibold text-indigo-600 hover:text-indigo-700 transition-colors" do %>
            Ver todas →
          <% end %>
        </div>

        <% if @recent_provas.any? %>
          <div class="divide-y divide-slate-100/80">
            <% @recent_provas.each do |prova| %>
              <%= link_to prova_path(prova), class: "group flex items-center gap-4 px-6 py-4 hover:bg-slate-50/60 transition-colors duration-150" do %>
                <div class="shrink-0 w-10 h-10 rounded-xl bg-indigo-50 text-indigo-500 flex items-center justify-center group-hover:bg-indigo-100 transition-colors">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold text-slate-800 truncate group-hover:text-indigo-600 transition-colors"><%= prova.titulo %></p>
                  <p class="text-xs text-slate-400 mt-0.5">
                    <% if prova.aluno.present? %>
                      <%= prova.aluno.nome %> · 
                    <% end %>
                    <%= prova.questoes.size %> quest<%= prova.questoes.size != 1 ? 'ões' : 'ão' %>
                  </p>
                </div>
                <span class="hidden sm:inline-flex px-2.5 py-1 rounded-lg bg-slate-100 text-xs font-medium text-slate-500"><%= prova.created_at.strftime("%d/%m/%Y") %></span>
                <svg class="w-4 h-4 text-slate-300 group-hover:text-indigo-400 transition-colors shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="px-6 py-14 text-center">
            <div class="mx-auto w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center mb-3">
              <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
            </div>
            <p class="text-sm font-semibold text-slate-700 mb-1">Nenhuma prova ainda</p>
            <p class="text-xs text-slate-400 mb-4">Crie sua primeira prova para começar</p>
            <%= link_to new_prova_path, class: "inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-800 transition-colors" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
              Criar primeira prova
            <% end %>
          </div>
        <% end %>
      </div>
    </section>

    <!-- RIGHT: Sidebar (1/3) -->
    <aside class="space-y-6">
      <!-- Quick Actions -->
      <div class="rounded-2xl bg-white border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100">
          <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Ações rápidas</h2>
        </div>
        <div class="p-3 space-y-1">
          <%= link_to new_prova_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-50 transition-colors duration-150 group" do %>
            <div class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-500 flex items-center justify-center group-hover:bg-indigo-100 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            </div>
            <span class="text-sm font-medium text-slate-700 group-hover:text-slate-900">Criar nova prova</span>
          <% end %>

          <%= link_to import_alunos_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-50 transition-colors duration-150 group" do %>
            <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-500 flex items-center justify-center group-hover:bg-emerald-100 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
            </div>
            <span class="text-sm font-medium text-slate-700 group-hover:text-slate-900">Importar alunos</span>
          <% end %>

          <%= link_to import_provas_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-50 transition-colors duration-150 group" do %>
            <div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-500 flex items-center justify-center group-hover:bg-amber-100 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
            </div>
            <span class="text-sm font-medium text-slate-700 group-hover:text-slate-900">Importar provas</span>
          <% end %>

          <%= link_to alunos_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-50 transition-colors duration-150 group" do %>
            <div class="w-8 h-8 rounded-lg bg-violet-50 text-violet-500 flex items-center justify-center group-hover:bg-violet-100 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <span class="text-sm font-medium text-slate-700 group-hover:text-slate-900">Gerenciar alunos</span>
          <% end %>

          <%= link_to turmas_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-50 transition-colors duration-150 group" do %>
            <div class="w-8 h-8 rounded-lg bg-teal-50 text-teal-500 flex items-center justify-center group-hover:bg-teal-100 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6z"/></svg>
            </div>
            <span class="text-sm font-medium text-slate-700 group-hover:text-slate-900">Gerenciar turmas</span>
          <% end %>
            <%= link_to provas_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-50 transition-colors duration-150 group" do %>
            <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-500 flex items-center justify-center group-hover:bg-blue-100 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <span class="text-sm font-medium text-slate-700 group-hover:text-slate-900">Gerenciar Provas</span>
          <% end %>
        </div>
      </div>

      <!-- Recent Alunos -->
      <div class="rounded-2xl bg-white border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
          <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Alunos recentes</h2>
          <%= link_to alunos_path, class: "text-xs font-semibold text-indigo-600 hover:text-indigo-700 transition-colors" do %>
            Ver todos →
          <% end %>
        </div>

        <% if @recent_alunos.any? %>
          <div class="divide-y divide-slate-100/80">
            <% avatar_colors = ['from-indigo-400 to-violet-400', 'from-emerald-400 to-teal-400', 'from-amber-400 to-orange-400', 'from-rose-400 to-pink-400', 'from-sky-400 to-cyan-400'] %>
            <% @recent_alunos.each_with_index do |aluno, idx| %>
              <%= link_to edit_aluno_path(aluno), class: "group flex items-center gap-3 px-6 py-3 hover:bg-slate-50/60 transition-colors duration-150" do %>
                <div class="shrink-0 w-8 h-8 rounded-lg bg-gradient-to-br <%= avatar_colors[idx % avatar_colors.length] %> flex items-center justify-center text-white text-xs font-bold">
                  <%= aluno.nome[0].upcase %>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-slate-700 truncate group-hover:text-slate-900 transition-colors"><%= aluno.nome %></p>
                  <p class="text-xs text-slate-400 truncate"><%= aluno.ra %></p>
                </div>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="px-6 py-8 text-center">
            <p class="text-xs text-slate-400">Nenhum aluno cadastrado</p>
          </div>
        <% end %>
      </div>
    </aside>
  </div>

  <section>
    <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-4">Primeiros passos</h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <!-- Step 1 -->
      <div class="group relative rounded-2xl bg-white border border-slate-200/80 p-5 shadow-sm hover:shadow-md hover:border-indigo-200 transition-all duration-200">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-8 h-8 rounded-lg bg-indigo-500 text-white text-xs font-bold flex items-center justify-center">1</div>
          <!--
          <% if @alunos_count > 0 %>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-50 text-xs font-semibold text-emerald-600">
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Feito
            </span>
          <% end %>
          <-->
        </div>
        <h3 class="text-sm font-bold text-slate-900 mb-1">Adicione um Aluno</h3>
        <p class="text-xs text-slate-500 mb-3 leading-relaxed">Defina, RA,Nome,Email</p>
        <%= link_to new_aluno_path, class: "inline-flex items-center gap-1 text-xs font-semibold text-indigo-600 hover:text-indigo-700 group-hover:gap-2 transition-all" do %>
          Adicionar aluno
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        <% end %>
      </div>

      <!-- Step 2 -->
      <div class="group relative rounded-2xl bg-white border border-slate-200/80 p-5 shadow-sm hover:shadow-md hover:border-emerald-200 transition-all duration-200">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-8 h-8 rounded-lg bg-emerald-500 text-white text-xs font-bold flex items-center justify-center">2</div>
          
          <!--
          <% if @provas_count > 0 %>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-50 text-xs font-semibold text-emerald-600">
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Feito
            </span>
          <% end %>
        -->
        </div>
        <h3 class="text-sm font-bold text-slate-900 mb-1">Configure uma prova</h3>
        <p class="text-xs text-slate-500 mb-3 leading-relaxed">Adicione a prova a um aluno</p>
        <%= link_to provas_path, class: "inline-flex items-center gap-1 text-xs font-semibold text-emerald-600 hover:text-emerald-700 group-hover:gap-2 transition-all" do %>
          Ver provas
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        <% end %>
      </div>

      <div class="group relative rounded-2xl bg-white border border-slate-200/80 p-5 shadow-sm hover:shadow-md hover:border-violet-200 transition-all duration-200">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-8 h-8 rounded-lg bg-violet-500 text-white text-xs font-bold flex items-center justify-center">3</div>
        </div>
        <h3 class="text-sm font-bold text-slate-900 mb-1">Corrija com IA</h3>
        <p class="text-xs text-slate-500 mb-3 leading-relaxed">Use IA para corrigir dissertativas e gerar análises.</p>
        <%= link_to provas_path, class: "inline-flex items-center gap-1 text-xs font-semibold text-violet-600 hover:text-violet-700 group-hover:gap-2 transition-all" do %>
          Explorar
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        <% end %>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════ -->
