  <!-- ═══════════════════════════════════════════════════════════ -->
  <footer class="pt-6 border-t border-slate-200/60">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>© <%= Date.current.year %> Provas App — Plataforma de gestão de avaliações</p>
      <div class="flex items-center gap-4">
        <%= link_to "Dashboard", dashboard_path, class: "hover:text-slate-600 transition-colors" %>
        <%= link_to "Provas", provas_path, class: "hover:text-slate-600 transition-colors" %>
        <%= link_to "Alunos", alunos_path, class: "hover:text-slate-600 transition-colors" %>
        <%= link_to "Turmas", turmas_path, class: "hover:text-slate-600 transition-colors" %>
      </div>
    </div>
  </footer>

</div>
